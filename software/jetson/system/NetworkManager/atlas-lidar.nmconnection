# SICK TiM561 on a USB 3 gigabit Ethernet adapter in a dev-kit USB-A port (rev B; the brain board's
# LAN7800 is gone). udev names the adapter lidar0 (99-atlas.rules); this profile matches the
# drivers instead, so it works even if the rename did not happen. RTL8153 adapters use r8152,
# ASIX AX88179 ones ax88179_178a (some kernels bind the B version to cdc_ncm: if `ethtool -i`
# says cdc_ncm, add it here; it is left out because USB gadget links can use it too).
# The TiM561 ships at 192.168.0.1/24 (docs/ARCHITECTURE.md); this side takes .100.
[connection]
id=atlas-lidar
type=ethernet
autoconnect=true

[match]
driver=r8152;ax88179_178a;lan78xx;

[ethernet]

[ipv4]
method=manual
address1=192.168.0.100/24
never-default=true

[ipv6]
method=disabled
