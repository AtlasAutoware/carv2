 (text "Main switch: TPS48111 + 4 FETs, MCU-sequenced precharge" (exclude_from_sim no) (at 25.4 25.4 0) (effects (font (size 3 3) (thickness 0.5) bold) (justify left)) (uuid "e3726769-26bf-53e2-bbd1-02d5a6aacb4e"))
(text "EN from the power latch. The MCU turns on INP_G (precharge through 10 Ohm), checks VM, then INP (main FETs)." (exclude_from_sim no) (at 25.4 33.02 0) (effects (font (size 1.8 1.8)) (justify left)) (uuid "dd5edf2e-2dae-531b-880c-41bfcd2f9968"))
(text "RSNS 0.2 mOhm. SCP: RISCP 4.02k -> 350 A in 1.2 us. OCP: RIWRN 39.2k, RSET 100 -> 150 A for 10 ms (CTMR 680 nF)." (exclude_from_sim no) (at 25.4 38.1 0) (effects (font (size 1.8 1.8)) (justify left)) (uuid "6a98a6e3-f8f6-57cd-9d35-25fda9e792e6"))
(text "IMON: gain 0.9 x 5.1k / 100 = 46 -> 150 A reads 1.38 V on PA5. Auto-retry after 15 s." (exclude_from_sim no) (at 25.4 43.18000000000001 0) (effects (font (size 1.8 1.8)) (justify left)) (uuid "4b153075-c029-5438-ba11-d2ce3421127d"))
(text "CBST 2.2 uF (4 x 118 nC gate charge). Remote temperature: MMBT3904 at the FETs on DIODE." (exclude_from_sim no) (at 25.4 48.260000000000005 0) (effects (font (size 1.8 1.8)) (justify left)) (uuid "bb934805-f106-551e-adfc-556cd36a0bfa"))
