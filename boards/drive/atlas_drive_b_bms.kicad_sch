(text "Sense 0.5 mOhm: OCD1 140 A, OCD2 280 A, SCD 600 A, OCC 120 A. VESC input limit (90 A) stays under OCD1." (exclude_from_sim no) (at 25.4 38.1 0) (effects (font (size 1.8 1.8)) (justify left)) (uuid "643c09ed-9dbf-5f93-bf7d-5c56ba1ab486"))
(text "4S: CCFG to AVDD; VC5 shorted to VC4 at the pins (datasheet 11). Internal balancing: 33 Ohm / 1 uF per input (RINI, CINI)." (exclude_from_sim no) (at 25.4 43.18000000000001 0) (effects (font (size 1.8 1.8)) (justify left)) (uuid "ca6e39df-4cc7-5c5f-8d44-f854fa9dec34"))
(text "DSG FETs source on the shunt side, CHG FETs source on PACK- (GND), drains common (FET_MID)." (exclude_from_sim no) (at 25.4 48.260000000000005 0) (effects (font (size 1.8 1.8)) (justify left)) (uuid "490f3360-d047-5705-bd79-7c7029056723"))
