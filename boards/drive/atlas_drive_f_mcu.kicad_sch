 (text "STM32F405 running VESC firmware, IMU, CAN, hall sensors, servo signal" (exclude_from_sim no) (at 25.4 25.4 0) (effects (font (size 3 3) (thickness 0.5) bold) (justify left)) (uuid "02e5d1da-3522-51ca-9d92-c45464439574"))
(text "Pin map = Trampa HD60 (hw_hd60) except: IMU SDA moved PB2 -> PC11 so BOOT1 stays low for the ROM bootloader," (exclude_from_sim no) (at 25.4 33.02 0) (effects (font (size 1.8 1.8)) (justify left)) (uuid "fe592df2-5053-520f-b87d-db09dfca2bf5"))
(text "power hold replaced by KILL on PB12 (latch), and new I/O: PA4 brain power, PA5 IMON, PA6 MAIN_ON, PA7 PRECHG_ON," (exclude_from_sim no) (at 25.4 38.1 0) (effects (font (size 1.8 1.8)) (justify left)) (uuid "6f3f2880-92f8-5841-b36c-b4e25070ab1e"))
(text "PC10 E-stop sense, PC14 power-button request to the Jetson, PC15 Jetson halted. See firmware/vesc/hw_atlas_drv1.h." (exclude_from_sim no) (at 25.4 43.18000000000001 0) (effects (font (size 1.8 1.8)) (justify left)) (uuid "19eb2ab3-9f54-5b32-a152-b3895f1da73f"))
(text "USART3 (PB10/PB11) to the Jetson at 115200 like car 1. USB to hub port 2 for VESC Tool. SWD on a 1.27 mm 2x5." (exclude_from_sim no) (at 25.4 48.260000000000005 0) (effects (font (size 1.8 1.8)) (justify left)) (uuid "58d78395-fff9-5ec5-ba71-95b218799d9d"))
