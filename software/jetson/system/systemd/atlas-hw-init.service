[Unit]
Description=Atlas car hardware set-up (heartbeat and JETSON_UP running, lidar power per atlas.conf)
Wants=atlas-battery.service
After=atlas-battery.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/atlas/atlas.conf
ExecStart=-/usr/local/bin/atlas hw-init

[Install]
WantedBy=multi-user.target
