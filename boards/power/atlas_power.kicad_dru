(version 1)
(rule "BMS-side domain 2 mm from everything else" (constraint clearance (min 2.0mm)) (condition "A.NetClass == 'BMS' && B.NetClass != 'BMS'"))
(rule "one thermal spoke is enough (fills on both layers)" (constraint min_resolved_spokes 1) (condition "A.Type == 'Pad' && B.Type == 'Zone'"))
(rule "TO-92 land pattern Q1001" (constraint clearance (min 0.2mm)) (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.intersectsCourtyard('Q1001') && B.intersectsCourtyard('Q1001')"))
(rule "TO-92 land pattern Q305" (constraint clearance (min 0.2mm)) (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.intersectsCourtyard('Q305') && B.intersectsCourtyard('Q305')"))
