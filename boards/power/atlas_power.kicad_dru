(rule "TO-92 land pattern U402" (constraint clearance (min 0.2mm)) (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.intersectsCourtyard('U402') && B.intersectsCourtyard('U402')"))
(rule "TO-92 land pattern U602" (constraint clearance (min 0.2mm)) (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.intersectsCourtyard('U602') && B.intersectsCourtyard('U602')"))
