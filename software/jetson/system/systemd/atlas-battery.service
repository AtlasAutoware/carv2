[Unit]
Description=Atlas supervisor link (heartbeat, JETSON_UP, status) and battery monitor
After=local-fs.target

[Service]
EnvironmentFile=-/etc/atlas/atlas.conf
ExecStart=/usr/local/bin/atlas battery-daemon
# The supervisor switches the car off 60 s after the last heartbeat (120 s after the "bye" this
# service sends when it stops), so come back quickly after a crash.
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
