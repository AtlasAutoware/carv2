 (text "E-stop loop, fan, mounting holes, board ID" (exclude_from_sim no) (at 25.4 25.4 0) (effects (font (size 3 3) (thickness 0.5) bold) (justify left)) (uuid "6a40b268-47b5-58a7-b872-c3c812ad08f7"))
(text "E-stop: 3.3 V -> 1k -> normally-closed loop (JST-PH 2) -> 100 Ohm -> ESTOP_OK, 10k + 10 nF to GND (0.1 ms;" (exclude_from_sim no) (at 25.4 33.02 0) (effects (font (size 1.8 1.8)) (justify left)) (uuid "9fb9bb69-d9bc-54c1-8c74-2090f28d707d"))
(text "review m3: a slow edge into the non-Schmitt 74HCT08 could chatter the main switch)." (exclude_from_sim no) (at 25.4 38.1 0) (effects (font (size 1.8 1.8)) (justify left)) (uuid "23d40d4f-cefe-54f8-a61c-b2f54d546432"))
(text "Closed = 3.0 V (HCT VIH 2.0 V, Pico VIH 2.0 V); open or unplugged = 0 V = stop. BAT85 clamps on the lead." (exclude_from_sim no) (at 25.4 43.18000000000001 0) (effects (font (size 1.8 1.8)) (justify left)) (uuid "03ab158d-c42d-5161-8211-c82e95d35ed7"))
(text "Fan 4-pin 5 V: PWM from GP16 through a 2N7000 (open drain); with the Pico off the fan runs at full speed." (exclude_from_sim no) (at 25.4 48.260000000000005 0) (effects (font (size 1.8 1.8)) (justify left)) (uuid "bb43cd9d-1db5-5eab-aefa-084cbdcedfd0"))
(text "Mounting: 6 x M3 at (4,4), (4,80), (75,4), (75,80), (L-4,4), (L-4,80), 7 mm keep-out, not plated." (exclude_from_sim no) (at 25.4 53.34 0) (effects (font (size 1.8 1.8)) (justify left)) (uuid "ed7d5cec-e150-527e-87e7-2021b795fd68"))
