(version 1)
(rule "land pattern U1001" (constraint clearance (min 0.15mm)) (condition "A.memberOfFootprint('U1001') && B.memberOfFootprint('U1001')"))
(rule "land pattern U402" (constraint clearance (min 0.15mm)) (condition "A.memberOfFootprint('U402') && B.memberOfFootprint('U402')"))
(rule "land pattern U602" (constraint clearance (min 0.15mm)) (condition "A.memberOfFootprint('U602') && B.memberOfFootprint('U602')"))
(rule "land pattern U801" (constraint clearance (min 0.15mm)) (condition "A.memberOfFootprint('U801') && B.memberOfFootprint('U801')"))
(rule "land pattern U802" (constraint clearance (min 0.15mm)) (condition "A.memberOfFootprint('U802') && B.memberOfFootprint('U802')"))
(rule "land pattern U501" (constraint clearance (min 0.15mm)) (condition "A.memberOfFootprint('U501') && B.memberOfFootprint('U501')"))
(rule "land pattern U701" (constraint clearance (min 0.15mm)) (condition "A.memberOfFootprint('U701') && B.memberOfFootprint('U701')"))
(rule "USB-C shell pegs (GCT land pattern)" (constraint hole_clearance (min 0.15mm)) (condition "A.memberOfFootprint('J701') || B.memberOfFootprint('J701')"))
(rule "stack header GND pins on the inner fills: one spoke is enough, the planes and outer fills connect them too" (layer inner) (constraint min_resolved_spokes 1) (condition "A.memberOfFootprint('J1001')"))
